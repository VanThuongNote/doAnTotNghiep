# Sao chép file này thành `.env` rồi điền giá trị thật:
#   copy .env.example .env

# Django
# Tạo key mới: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY='change-me'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database MySQL
DB_NAME=quanlysukien
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Email (Gmail SMTP) - App Password 16 ký tự: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=

# Mapbox
MAPBOX_KEY=
